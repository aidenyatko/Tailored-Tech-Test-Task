# Frontend mode.
# api: use the real NestJS API through /api.
# mock: use the in-browser demo backend for Vercel/static hosting.
VITE_DEMO_MODE=api

# Login form defaults shown in the browser.
VITE_DEFAULT_LOGIN_EMAIL=owner@acme.test
VITE_DEFAULT_LOGIN_PASSWORD=owner123
VITE_DEMO_ACCOUNTS_TEXT=Demo accounts: owner@acme.test / owner123, editor@acme.test / editor123, viewer@acme.test / viewer123.

# Docker Compose host ports.
COMPOSE_FRONTEND_PORT=8080
COMPOSE_POSTGRES_PORT=5438

# Backend runtime.
BACKEND_PORT=8080
UPLOAD_DIR=/app/uploads
BACKEND_DATABASE_URL=postgresql://dataroom:dataroom@postgres:5432/dataroom?schema=public

# PostgreSQL container.
POSTGRES_DB=dataroom
POSTGRES_USER=dataroom
POSTGRES_PASSWORD=dataroom
